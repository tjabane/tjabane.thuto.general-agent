{
  "name": "tjabane.thuto.general-agent",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "src/*"
  ],
  "scripts": {
    "agent": "bun run --filter @general-agent/agent start",
    "check": "biome check .",
    "eval:baseline": "bun run evals/baseline/index.ts",
    "eval:gaia": "bun run evals/gaia/index.ts",
    "eval:gaia:level1": "bun run evals/gaia/index.ts --provider ollama --level 1 --count 53 --split validation --concurrency 3",
    "gaia:download": "bun run evals/gaia/download.ts",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "hyparquet": "^1.31.3"
  }
}
